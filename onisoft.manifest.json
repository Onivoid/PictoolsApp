{
  "id": "pictools",
  "name": {
    "fr": "Pictools",
    "en": "Pictools"
  },
  "description": {
    "fr": "Boîte à outils image locale — conversion, icônes app, sans upload.",
    "en": "Local-first image toolbox — conversion, app icons, no uploads."
  },
  "branding": {
    "primaryColor": "#22d3ee",
    "logo": "https://raw.githubusercontent.com/Onivoid/PictoolsApp/main/public/pictools.svg"
  },
  "repo": "https://github.com/Onivoid/PictoolsApp",
  "version": {
    "source": "github-releases",
    "repo": "Onivoid/PictoolsApp"
  },
  "download": {
    "windows-x86_64": {
      "asset": "PictoolsApp_*_x64-setup.exe",
      "kind": "installer",
      "match": "glob"
    },
    "darwin-universal": {
      "asset": "PictoolsApp.app.tar.gz",
      "kind": "archive"
    },
    "linux-x86_64": {
      "asset": "PictoolsApp_*_amd64.AppImage",
      "kind": "archive",
      "match": "glob"
    }
  },
  "launch": {
    "windows": {
      "executable": "PictoolsApp.exe",
      "candidates": [
        "%LOCALAPPDATA%/PictoolsApp/PictoolsApp.exe",
        "%LOCALAPPDATA%/Programs/PictoolsApp/PictoolsApp.exe",
        "%PROGRAMFILES%/PictoolsApp/PictoolsApp.exe"
      ]
    },
    "macos": {
      "executable": "PictoolsApp.app",
      "candidates": [
        "/Applications/PictoolsApp.app"
      ]
    },
    "linux": {
      "executable": "PictoolsApp.AppImage",
      "candidates": []
    }
  }
}
